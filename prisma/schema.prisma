// GridironIQ™ — Football Intelligence OS
// Prisma schema (SQLite)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- Multi-Tenant Hierarchy ----------

model District {
  id          String   @id @default(cuid())
  name        String   // e.g. "Royse City ISD"
  state       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schools     School[]
  users       User[]
  auditEvents AuditEvent[]
}

model School {
  id          String   @id @default(cuid())
  districtId  String
  district    District @relation(fields: [districtId], references: [id], onDelete: Cascade)
  name        String   // e.g. "Royse City High School"
  level       String?  // middle, freshman, jv, varsity
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  programs    Program[]
}

model Program {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String   // e.g. "Football"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teams       Team[]
}

// ---------- Organizations & Team Memory ----------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String
  role          String    @default("coach") // super_admin, district_admin, school_admin, athletic_director, head_coach, offensive_coordinator, defensive_coordinator, special_teams_coordinator, position_coach, analyst, player, parent_guardian, read_only
  districtId    String?
  district      District? @relation(fields: [districtId], references: [id], onDelete: SetNull)
  teamId        String?
  team          Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  // Policy-based permissions (JSON array of permission strings)
  permissions  String?   // e.g. '["can_view_player_progress","can_assign_content","can_edit_playbook"]'
  grade        String?   // for players: "9th","10th","11th","12th"
  dateOfBirth  DateTime? // for COPPA age verification
  parentEmail  String?   // for parent_guardian consent workflows
  consentGiven Boolean  @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Team {
  id          String   @id @default(cuid())
  programId   String?
  program     Program? @relation(fields: [programId], references: [id], onDelete: SetNull)
  name        String
  philosophy  String   // Spread, Air Raid, West Coast, etc.
  primaryColor String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  players     Player[]
  plays       Play[]
  opponents   Opponent[]
  games       Game[]
  callSheets  CallSheet[]
  installPlans InstallPlan[]
  users       User[]
  filmClips   FilmClip[]
  customDrills CustomDrill[]
  weeklyTasks WeeklyTask[]
  learningEvents LearningEvent[]
  assignments Assignment[]
  masteryRecords MasteryRecord[]
  reviewItems   ReviewItem[]
}

model Player {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  jersey    Int
  name      String
  position  String   // QB, RB, WR, TE, OL, DL, LB, DB, K, P
  group     String   // offensive / defensive / special_teams
  height    String?
  weight    Int?
  speedGrade String? // A+, A, B+, B, C
  notes     String?
  quizScore Float?   // 0-100 mastery
  createdAt DateTime @default(now())
  learningEvents LearningEvent[]
  masteryRecords MasteryRecord[]
  reviewItems   ReviewItem[]
}

// ---------- PlaybookIQ — Play DNA ----------

model Formation {
  id          String   @id @default(cuid())
  code        String   @unique // GUN_TRIPS_R, I_PRO_L, etc.
  name        String   // Gun Trips Right
  side        String   // offense/defense
  personnel   String   // 11, 12, 21, 10, etc.
  backfield   String?  // gun, pistol, under-center, shotgun
  strength    String?  // field, boundary, right, left
  description String?
  createdAt   DateTime @default(now())

  plays       Play[]
}

model PlayFamily {
  id          String   @id @default(cuid())
  code        String   @unique // INSIDE_ZONE_FAMILY, etc.
  name        String
  side        String   // offense/defense
  baseConcept String
  description String?
  createdAt   DateTime @default(now())

  plays       Play[]
}

model Play {
  id              String   @id @default(cuid())
  teamId          String?
  team            Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  formationId     String?
  formation       Formation? @relation(fields: [formationId], references: [id], onDelete: SetNull)
  familyId        String?
  family          PlayFamily? @relation(fields: [familyId], references: [id], onDelete: SetNull)
  playId          String   @unique // OFF-RPO-0172
  name            String   // Gun Trips F Jet IZ Glance
  side            String   // offense/defense
  personnel       String?
  motion          String?
  concept         String   // inside_zone, glance_rpo, cover_3_match, etc.
  readType        String?  // conflict_defender, half-field, full-field
  readDefender    String?  // boundary_apex, mike, etc.
  protection      String?
  qbFootwork      String?
  constraints     String?  // JSON array
  preferredFronts String?  // JSON array
  coverageTargets String?  // JSON array
  fieldZones      String?  // JSON array
  coachingPoints  String?
  assignments     String?  // JSON array of {position, assignment}
  routes          String?  // JSON array of {player, route}
  diagram         String?  // JSON: player positions + paths
  complementary   String?  // JSON array of complementary play ids
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  snapResults     SnapResult[]
}

// ---------- ScoutIQ — Opponent Intelligence ----------

model Opponent {
  id          String   @id @default(cuid())
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name        String   // Central High
  mascot      String?
  league      String?
  scoutSummary String? // AI-generated summary
  createdAt   DateTime @default(now())

  games       Game[]
  snapResults SnapResult[]
  tendencies  Tendency[]
}

model Tendency {
  id          String   @id @default(cuid())
  opponentId  String
  opponent    Opponent @relation(fields: [opponentId], references: [id], onDelete: Cascade)
  situation   String   // 3rd_&_7+, 1st_&_10, red_zone, etc.
  formationKey String? // Trips, Empty, etc.
  personnel   String?
  hash        String?
  result      String   // pass / run / pressure / coverage
  value       String   // Mesh, Cover 3, QB Draw, etc.
  probability Float    // 0-1
  sampleSize  Int
  confidence  String   // HIGH / MEDIUM / LOW
  notes       String?
  createdAt   DateTime @default(now())
}

// ---------- GamePlanIQ & Postgame ----------

model Game {
  id          String   @id @default(cuid())
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  opponentId  String?
  opponent    Opponent? @relation(fields: [opponentId], references: [id], onDelete: SetNull)
  week        Int
  date        DateTime
  location    String   // home/away/neutral
  ourScore    Int?
  oppScore    Int?
  result      String?  // W/L
  createdAt   DateTime @default(now())

  snapResults SnapResult[]
  callSheets  CallSheet[]
}

model SnapResult {
  id          String   @id @default(cuid())
  gameId      String?
  game        Game?    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  playId      String?
  play        Play?    @relation(fields: [playId], references: [id], onDelete: SetNull)
  opponentId  String?
  opponent    Opponent? @relation(fields: [opponentId], references: [id], onDelete: SetNull)
  quarter     Int
  clock       String?
  down        Int
  distance    Int
  hash        String?  // left/right/middle
  yardLine    Int
  formation    String?
  personnel   String?
  motion      String?
  concept      String?
  front       String?
  coverage    String?
  pressure    String?
  playType    String?  // run/pass
  yardsGained Int
  success     Boolean
  explosive   Boolean
  negative    Boolean
  turnover    Boolean
  penalty     Boolean?
  createdAt   DateTime @default(now())
}

model CallSheet {
  id          String   @id @default(cuid())
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  gameId      String?
  game        Game?    @relation(fields: [gameId], references: [id], onDelete: SetNull)
  name        String
  sections    String   // JSON: [{situation, plays:[{playId, note, priority}]}]
  createdAt   DateTime @default(now())
}

model InstallPlan {
  id          String   @id @default(cuid())
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  day         Int      // 1, 2, 3...
  title       String
  focus       String?
  sections    String   // JSON: [{period, items:[{type, name}]}]
  createdAt   DateTime @default(now())
}

// ---------- User-Generated Content (persisted) ----------

model FilmClip {
  id          String   @id @default(cuid())
  teamId      String?
  team        Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  title       String
  description String
  opponentId  String?
  tags        String   // JSON: {personnel, formation, concept, coverage, ...}
  videoUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CustomDrill {
  id          String   @id @default(cuid())
  teamId      String?
  team        Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name        String
  category    String   // passing, run_game, team, special_teams, defense, individual
  duration    Int      // minutes
  intensity   String   // low, medium, high
  group       String   // team, offense, defense, special
  equipment   String   // JSON array
  coachingPoints String // JSON array
  progression String   // JSON array
  tags        String   // JSON array
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WeeklyTask {
  id          String   @id @default(cuid())
  teamId      String?
  team        Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  day         String   // Sunday, Monday, ...
  label       String
  done        Boolean  @default(false)
  sortOrder   Int      @default(0)
  isCustom    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------- Player Accountability & Learning Analytics ----------

model LearningEvent {
  id            String   @id @default(cuid())
  teamId        String?
  team          Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  playerId      String
  player        Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  assignmentId  String?
  playId        String?
  eventType     String
  eventSource   String?
  attemptNumber Int?
  score         Float?
  durationMs    Int?
  correct       Boolean?
  errorType     String?
  metadata      String?
  createdAt     DateTime @default(now())
}

model Assignment {
  id              String   @id @default(cuid())
  teamId          String?
  team            Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  assignedBy      String?
  positionGroup   String?
  targetType      String
  playId          String?
  type            String
  dueDate         DateTime?
  priority        Int      @default(1)
  requiredScore   Float?
  status          String   @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model MasteryRecord {
  id                    String   @id @default(cuid())
  teamId                String?
  team                  Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  playerId              String
  player                Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playId                String?
  concept               String?
  formationRecognition  Float    @default(0)
  alignmentAccuracy     Float    @default(0)
  assignmentAccuracy    Float    @default(0)
  routeAccuracy         Float    @default(0)
  blockingRuleAccuracy  Float    @default(0)
  readAccuracy          Float    @default(0)
  adjustmentAccuracy    Float    @default(0)
  defensiveRecognition  Float    @default(0)
  recallAccuracy        Float    @default(0)
  overallMastery         Float    @default(0)
  confidence            Float    @default(0)
  attemptCount          Int      @default(0)
  lastReviewed          DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// ---------- Audit Logging ----------

model AuditEvent {
  id            String   @id @default(cuid())
  districtId    String?
  district      District? @relation(fields: [districtId], references: [id], onDelete: SetNull)
  userId        String?
  userEmail     String?
  action        String   // LOGIN, LOGOUT, LOGIN_FAILED, ROLE_CHANGE, PLAYBOOK_EXPORT, PLAYER_ADDED, PLAYER_REMOVED, COACH_ADDED, DATA_EXPORT, DATA_DELETE, SETTINGS_CHANGE
  resourceType  String?  // user, play, player, opponent, call_sheet, film_clip, drill
  resourceId    String?
  metadata      String?  // JSON
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())
}

// ---------- Review Queue (Spaced Retrieval) ----------

model ReviewItem {
  id            String   @id @default(cuid())
  teamId        String?
  team          Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  playerId      String
  player        Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  concept       String   // inside_zone, mesh, cover_3, etc.
  playId        String?
  nextReview    DateTime
  lastReviewed  DateTime?
  interval      Int      @default(1) // days: 1, 3, 7, 14, 30
  priority      Int      @default(5) // 1-10
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
